diff --git a/src/test/java/io/tinykv/CompactionRaceTest.java b/src/test/java/io/tinykv/CompactionRaceTest.java
index 9610a84..23f8c8d 100644
--- a/src/test/java/io/tinykv/CompactionRaceTest.java
+++ b/src/test/java/io/tinykv/CompactionRaceTest.java
@@ -15,12 +15,9 @@ import static org.assertj.core.api.Assertions.assertThat;
 /**
  * Runs compaction concurrently with deletes and reads.
  *
- * Compaction runs outside the write lock. For each live record it checks the index
- * ({@code index.get}) and later re-inserts the key ({@code putIfNewer}). If a delete
- * lands between those two calls, the index no longer has an entry, so
- * {@code putIfNewer} inserts the old value again and the deleted key comes back.
- * Readers can also pick up an index entry that points at a segment compaction has
- * just deleted.
+ * Guards two races that compaction used to have: a key deleted while compaction copied it
+ * could come back (in memory and after a restart), and reads could fail with "Unknown segment
+ * id" because index entries pointed at the new segment before it was registered.
  */
 class CompactionRaceTest {
 
